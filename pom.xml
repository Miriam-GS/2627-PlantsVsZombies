<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>es.ucm.fdi.tp1</groupId>  <!-- tu organización; ej.: es.ucm.fdi.tp1 -->
  <artifactId>plantsvszombies</artifactId>  <!-- nombre del proyecto -->
  <version>1.0.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <organization>
    <name>FDI - UCM</name>
    <url>https://informatica.ucm.es/</url>
  </organization>
  <developers>
    <developer>
      <id>id1</id>
      <name>My Name</name>
      <email>id1@ucm.es</email>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
    <developer>
      <id>id2</id>
      <name>My Name</name>
      <email>id2@ucm.es</email>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
  </developers>
  <repositories>
    <!-- configure local .m2 as local offline repository -->
    <repository>
      <id>local-m2</id>
      <name>Local .m2 folder within user home</name>
      <url>file://${user.home}/.m2/repository</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.14.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <mainClass>tp1.pvz.PlantsVsZombies</mainClass> <!-- para mvn exec:java -->
          <arguments>
            <!-- mueve argumentos fuera del comentario para que se usen
                <argument>arg1</argument>
                <argument>arg2</argument>
            -->
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
